{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tydel.dev/schemas/validator-result-v0.schema.json",
  "title": "Tydel Validator Result v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "status", "context", "rulePack", "error", "execution"],
  "properties": {
    "schemaVersion": { "const": "tydel.validator-result/v0" },
    "resultId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL"] },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "process", "message", "profile", "messageVersion", "syntax", "asOf"],
      "properties": {
        "jurisdiction": { "type": "string", "minLength": 2 },
        "process": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "messageVersion": { "type": "string", "minLength": 1 },
        "syntax": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" }
      }
    },
    "rulePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "contentHash": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "error": {
      "type": "array",
      "items": { "$ref": "#/$defs/errorItem" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineVersion", "mode", "offline", "durationMs"],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "mode": { "const": "LOCAL" },
        "offline": { "const": true },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
      "then": {
        "properties": {
          "error": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": { "severity": { "const": "ERROR" } },
              "required": ["severity"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "error": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "severity": { "const": "ERROR" } },
                "required": ["severity"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "publisher", "title", "edition", "section", "evidenceLevel", "effectiveFrom", "effectiveTo"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "evidenceLevel": { "enum": ["NORMATIVE", "PROCESS_GUIDE", "EXAMPLE", "SECONDARY"] },
        "effectiveFrom": { "type": ["string", "null"], "format": "date" },
        "effectiveTo": { "type": ["string", "null"], "format": "date" },
        "sourceChecksum": { "$ref": "#/$defs/nullableString" }
      }
    },
    "originalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "messageReference": { "$ref": "#/$defs/nullableString" },
        "transactionReference": { "$ref": "#/$defs/nullableString" }
      }
    },
    "errorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "ruleLayer", "segmentPath", "canonicalPath", "observed", "expected", "provenance", "nextStep"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^TYDEL-[A-Z0-9-]+$" },
        "severity": { "enum": ["ERROR", "WARNING"] },
        "ruleLayer": { "enum": ["BASE_STANDARD", "MARKET_PROFILE", "BUSINESS_PROCESS", "TYDEL_SAFETY"] },
        "segmentPath": { "type": "string", "minLength": 1 },
        "canonicalPath": { "type": "string", "minLength": 1 },
        "observed": { "type": "string" },
        "expected": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        },
        "originalResponse": {
          "anyOf": [
            { "$ref": "#/$defs/originalResponse" },
            { "type": "null" }
          ]
        },
        "nextStep": { "type": "string", "minLength": 1 }
      }
    }
  }
}
